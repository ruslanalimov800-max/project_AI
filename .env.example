# Скопируйте в .env (copy .env.example .env). Значения секретов в репозиторий не добавляются.
# Секретный ключ Django: обязателен при DEBUG=0; при DEBUG=1 используется встроенный ключ для разработки.
SECRET_KEY=
# 1 — режим разработки, 0 — демонстрационная сборка
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost
